# ─── Django ───────────────────────────────────────────────────────────────────
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://sweet-date-api.onrender.com

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Soit DATABASE_URL (Render), soit les variables DB_*.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_NAME=sweetdate_db
DB_USER=sweetdate_user
DB_PASSWORD=sweetdate_pass
DB_HOST=localhost
DB_PORT=5432

# ─── CORS (URL du frontend) ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Media (avatars) ──────────────────────────────────────────────────────────
# Servis par Django quand DEBUG=true. En prod : SERVE_MEDIA=true + disque persistant.
# SERVE_MEDIA=true
# MEDIA_ROOT=/var/data/media

# ─── Email Gmail SMTP ─────────────────────────────────────────────────────────
# Sans EMAIL_HOST_USER, les emails sont affichés dans la console.
# Créer un "App Password" sur https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Sweet Date <noreply@sweetdate.app>
